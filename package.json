{
  "name": "oncall-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A TypeScript OnCall Agent for incident triage and SOP-guided response",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && npm run test:data-source && npm run test:runtime && npm run test:retrieval",
    "test:data-source": "node --import tsx --test src/data-sources/disk-inspection-source.test.ts",
    "test:runtime": "node --import tsx --test src/agent/ops-agent-runtime.test.ts",
    "test:retrieval": "node --import tsx --test src/rag/retrieval.test.ts",
    "test:agent:acceptance": "node --import tsx --test src/agent/ops-agent.acceptance.test.ts",
    "build:rag-index": "tsx src/rag/build-tfidf-index.ts",
    "build:embedding-index": "tsx src/rag/build-embedding-index.ts",
    "eval:retrieval": "tsx src/rag/evaluate-retrieval.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.74.2",
    "@earendil-works/pi-ai": "^0.74.2",
    "@huggingface/transformers": "^4.2.0",
    "typebox": "^1.3.28"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
